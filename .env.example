# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Database. SQLite for local dev; swap for a Postgres URL in production
# and change the `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./prisma/dev.db"

# Auth.js session signing secret. Generate one with:
#   npx auth secret
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# LinkedIn OAuth credentials.
#
# Setup:
#   1. Create an app at https://www.linkedin.com/developers/apps
#   2. On the Products tab, request "Sign In with LinkedIn using OpenID Connect"
#      (self-serve, usually granted immediately)
#   3. On the Auth tab, add this Authorized redirect URL:
#        http://localhost:3000/api/auth/callback/linkedin
#      For production add: https://YOUR_DOMAIN/api/auth/callback/linkedin
#
# NOTE: this grants only `openid profile email` — name, photo, email, member id.
# LinkedIn does NOT expose the connection list to third-party apps; the app gets
# connections from the user's own official data export instead. See README.
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# Base URL of the app. Required in production; inferred in dev.
# AUTH_URL="https://your-domain.com"

# Optional: contact address embedded in the User-Agent sent to public ATS
# job boards, so their operators can reach you. Good citizenship.
ATS_CONTACT_EMAIL="you@example.com"
